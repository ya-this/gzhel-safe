# Environment variables for self-hosting the Gzhel Safe server.
# The Windows .exe sets these automatically; use them when running the
# server yourself with Node.js.

# Port the vault server listens on (default 3000)
PORT=3000

# Set to production when serving the built web app (dist/) instead of the
# Vite dev server.
NODE_ENV=production

# Optional: override where the vault data is stored (default ./.vault-data)
# VAULT_DATA_DIR=/var/lib/gzhel-safe

# Optional: override where the built web app lives (default ./dist)
# VAULT_DIST_DIR=/var/www/gzhel-safe/dist

# Optional: server-side master passcode override for the personal vault
# VAULT_PASSCODE=

# Receiver script token (when running gzhel-receiver-server.mjs standalone)
# RECEIVER_TOKEN=your-secret-token
